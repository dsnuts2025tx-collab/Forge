{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phantom-forge-engine",
  "main": "./runtime-entry.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FORGE_STATE",
        "class_name": "ForgeState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ForgeState"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
